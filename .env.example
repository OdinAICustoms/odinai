# OdinAi settings. Copy to .env and fill in. .env is never committed.
PORT=3200
NODE_ENV=development
# Password for the local PostgreSQL container (docker-compose.yml reads it too).
DB_PASSWORD=change-me
DATABASE_URL=postgres://odinai:change-me@localhost:5433/odinai
# Used only by `npm test`; created and emptied by the tests.
TEST_DATABASE_URL=postgres://odinai:change-me@localhost:5433/odinai_test
FILE_STORE=./data/files
# AI reading of documents (phase 2c). Without a key the AI intake is switched off; everything else works.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high
